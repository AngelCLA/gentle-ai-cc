#!/usr/bin/env bash
# gentle-cc — companion wrapper for Command Code.
#
# The official `gentle-ai` release manages every supported agent EXCEPT
# Command Code. This script builds a companion binary from your local branch
# (which carries the Command Code adapter) and runs it ONLY against
# `--agent command-code`, so the two binaries never fight over other agents.
#
# The official binary reads ~/.gentle-ai/state.json and fails its real sync
# when an agent ID it does not know is recorded there. The companion install
# records `command-code`, so every companion operation is followed by a
# cleanup that removes the Command Code IDs from installed_agents again.
# Help/dry-run skip cleanup. The wrapper lock cannot protect direct binary runs.
set -euo pipefail

REPO="${GENTLE_CC_REPO:-$HOME/dev/gentle-ai}"
BIN="${GENTLE_CC_BIN:-$HOME/.local/bin/gentle-ai-cc}"
OFFICIAL="${GENTLE_AI_BIN:-gentle-ai}"
CC_AGENT="command-code"

die() { printf 'gentle-cc: %s\n' "$*" >&2; exit 1; }

build() {
  [ -d "$REPO" ] || die "repo not found: $REPO (set GENTLE_CC_REPO)"
  command -v go >/dev/null 2>&1 || die "go not on PATH; required to build the companion"
  printf 'Building companion from %s ...\n' "$REPO"
  ( cd "$REPO" && go build -o "$BIN" ./cmd/gentle-ai ) || die "build failed"
  printf 'Built %s\n' "$BIN"
}

ensure_bin() {
  if [ ! -x "$BIN" ]; then build; fi
}

require_python() {
  command -v python3 >/dev/null 2>&1 || die "python3 required for shared-state cleanup"
}

# One reader/validator owns the shared schema for preflight, routing and cleanup.
state_action() {
  python3 - "$CC_AGENT" "$1" <<'PY'
import json, os, stat, sys, tempfile
cc, action = sys.argv[1:]
path = os.path.expanduser("~/.gentle-ai/state.json")
try:
    try:
        with open(path) as source:
            st = json.load(source)
            mode = stat.S_IMODE(os.fstat(source.fileno()).st_mode)
    except FileNotFoundError:
        st = {}
    if not isinstance(st, dict):
        raise ValueError("state must be a JSON object")
    agents = st.get("installed_agents", [])
    if not isinstance(agents, list) or any(not isinstance(a, str) for a in agents):
        raise ValueError("installed_agents must be a list of strings")
    cleaned = [a for a in agents if a not in (cc, "commandcode")]
    if action == "agents":
        print(",".join(dict.fromkeys(cleaned)))
    elif action == "clean" and cleaned != agents:
        st["installed_agents"] = cleaned
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=os.path.dirname(path),
                                             prefix=".gentle-cc-", delete=False) as out:
                temporary = out.name
                os.fchmod(out.fileno(), mode)
                json.dump(st, out, indent=2)
                out.write("\n")
                out.flush()
                os.fsync(out.fileno())
            os.replace(temporary, path)
        finally:
            if temporary is not None and os.path.exists(temporary):
                os.unlink(temporary)
except (OSError, ValueError) as error:
    print(f"gentle-cc: cannot clean shared state: {error}", file=sys.stderr)
    sys.exit(1)
PY
}

clean_state() { state_action clean; }
official_agents_from_state() { state_action agents; }

informational() {
  local arg dry_run=false
  for arg in "$@"; do
    case "$arg" in
      --help|-h) return 0 ;;
      # Match Go boolean spellings; repeated flags use the last value.
      --dry-run|--dry-run=1|--dry-run=t|--dry-run=T|--dry-run=true|--dry-run=TRUE|--dry-run=True)
        dry_run=true ;;
      --dry-run=0|--dry-run=f|--dry-run=F|--dry-run=false|--dry-run=FALSE|--dry-run=False)
        dry_run=false ;;
    esac
  done
  [ "$dry_run" = true ]
}

# Wrapper-owned routes must never forward user agent selectors to either binary.
# Scan tokens even after -- or another option: external parser semantics are not
# verified here, so a standalone selector-shaped token is conservatively denied.
# Embedded data such as --preset=--agent=pi is not a selector token.
reject_agent_selectors() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --agent|--agent=*)
        die "--agent is managed by the wrapper; not allowed for sync, install, or sync-all" ;;
    esac
  done
}

begin_mutation() {
  require_python
  local program guardian rc=0
  # Snapshot our functions/configuration, not an environment-controlled bypass
  # into this script. The supervised shell starts only after acquiring the lock.
  program="$(declare -f)
$(declare -p REPO BIN OFFICIAL CC_AGENT)
set -euo pipefail
trap 'exit 130' INT
trap 'exit 143' TERM
state_action validate
mutate \"\$@\""
  python3 - "$program" "$@" 3<&0 <<'PY' &
import errno, os, signal, stat, subprocess, sys

def fail(message):
    print('gentle-cc: ' + message, file=sys.stderr)
    sys.exit(1)

try:
    import fcntl
    if not callable(getattr(fcntl, 'flock', None)):
        raise ImportError()
except ImportError:
    fail('OS locking unavailable; requires Python 3 fcntl.flock on Linux/macOS')

child = None
pending = None

def stop(signum, frame):
    global pending
    pending = signum
    if child is not None:
        try:
            os.killpg(child.pid, signum)
        except ProcessLookupError:
            pass

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
path = os.path.expanduser('~/.gentle-ai/gentle-cc.lock')
try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # Never unlink this file: all wrappers must keep locking the same inode.
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        fail('cannot acquire shared-state lock; lock must be a regular single-link file')
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError as error:
    if error.errno in (errno.EAGAIN, errno.EACCES, errno.EISDIR):
        fail('shared state busy (gentle-cc.lock); see README recovery instructions')
    fail('cannot acquire shared-state OS lock; no mutation started')
try:
    if pending is not None:
        sys.exit(128 + pending)
    # The guardian survives death of the invoking wrapper. The operation shell
    # also inherits the locked descriptor and retains it while waiting for its
    # foreground binaries; no explicit LOCK_UN may release their shared lock.
    child = subprocess.Popen(['/bin/bash', '-c', sys.argv[1], 'gentle-cc', *sys.argv[2:]],
                             start_new_session=True, stdin=3, pass_fds=(fd,))
    if pending is not None:
        stop(pending, None)
    rc = child.wait()
    sys.exit(rc if rc >= 0 else 128 - rc)
except OSError:
    fail('cannot start locked operation; no mutation started')
finally:
    os.close(fd)
PY
  guardian=$!
  trap 'kill -TERM "$guardian" 2>/dev/null || :; exit 143' TERM
  trap 'kill -INT "$guardian" 2>/dev/null || :; exit 130' INT
  wait "$guardian" || rc=$?
  exit "$rc"
}

mutate() {
  local command="$1" others
  shift
  if [ "$command" = sync-all ]; then
    others="$(official_agents_from_state)"
    ensure_bin
    if [ -n "$others" ]; then
      printf 'Official sync: %s\n' "$others"
      "$OFFICIAL" sync --agent "$others" "$@" || die "official sync failed"
    else
      printf 'No other agents recorded; skipping official sync.\n'
    fi
    printf 'Companion sync: %s\n' "$CC_AGENT"
    command=sync
  fi
  run_companion "$command" --agent "$CC_AGENT" "$@"
}

run_companion() {
  ensure_bin
  local rc=0
  "$BIN" "$@" || rc=$?
  if ! informational "$@"; then clean_state; fi
  return "$rc"
}

case "${1:-help}" in
  build)   build ;;
  sync)
    shift
    reject_agent_selectors "$@"
    if ! informational "$@"; then begin_mutation sync "$@"; fi
    run_companion sync --agent "$CC_AGENT" "$@" ;;
  install)
    shift
    reject_agent_selectors "$@"
    if ! informational "$@"; then begin_mutation install "$@"; fi
    run_companion install --agent "$CC_AGENT" "$@" ;;
  doctor)
    shift; ensure_bin; "$BIN" doctor "$@" ;;
  sync-all)
    shift
    reject_agent_selectors "$@"
    if informational "$@"; then require_python; else begin_mutation sync-all "$@"; fi
    others="$(official_agents_from_state)"
    ensure_bin
    if [ -n "$others" ]; then
      printf 'Official sync: %s\n' "$others"
      "$OFFICIAL" sync --agent "$others" "$@" || die "official sync failed"
    else
      printf 'No other agents recorded; skipping official sync.\n'
    fi
    printf 'Companion sync: %s\n' "$CC_AGENT"
    run_companion sync --agent "$CC_AGENT" "$@" ;;
  help|--help|-h|*)
    cat <<'EOF'
gentle-cc — Command Code companion for gentle-ai

  gentle-cc build            Build the companion binary from your branch
  gentle-cc sync    [args]   Sync only Command Code (companion)
  gentle-cc install [args]   Install only Command Code (companion)
  gentle-cc doctor  [args]   Run doctor with the companion binary
  gentle-cc sync-all[args]   Official sync for other agents + Command Code

sync/install/sync-all reject user --agent and --agent=... (also with help/dry-run
or after --), before preflight, builds, binary execution or state writes. Error:
gentle-cc: --agent is managed by the wrapper; not allowed for sync, install, or sync-all
Exit status 1; stdout is empty. doctor/build/top-level help are unchanged.
Embedded values like --preset=--agent=pi pass through; standalone selector tokens
are rejected even as apparent option values. External parser forms are unverified.

Mutating install/sync/sync-all require Python 3 fcntl.flock (Linux/macOS).
The persistent OS lock file must never be removed, even when idle.
Legacy lock directories fail closed; no automatic recovery is performed.
Help (-h/--help) or effective --dry-run=true skips cleanup and locking.
Repeated --dry-run flags: last value wins (Go boolean spellings; bare = true).
Effective --dry-run=false still mutates. Do not run direct binaries concurrently.
See README for shared-state limitations and stale-lock recovery.

Env:
  GENTLE_CC_REPO   branch checkout        (default ~/dev/gentle-ai)
  GENTLE_CC_BIN    companion binary path  (default ~/.local/bin/gentle-ai-cc)
  GENTLE_AI_BIN    official binary        (default gentle-ai)
EOF
    ;;
esac
